rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // USUÁRIOS
    // =====================================================
    match /usuarios/{userId} {

      // Mantido público porque partes do projeto
      // atualmente utilizam esses dados.
      allow read: if true;

      // Cada usuário só pode criar/alterar o próprio cadastro
      allow create, update:
        if request.auth != null
        && request.auth.uid == userId;

      allow delete: if false;
    }


    // =====================================================
    // ANÚNCIOS
    // =====================================================
    match /anuncios/{anuncioId} {

      // Anúncios públicos
      allow read: if true;

      // Usuário logado pode criar
      allow create:
        if request.auth != null;

      // Somente o dono pode alterar/excluir
      allow update, delete:
        if request.auth != null
        && request.auth.uid == resource.data.autorUid;


      // ===================================================
      // CONTATO PRIVADO DO ANÚNCIO
      // ===================================================
      match /privado/{documento} {

        // Usuário logado pode consultar
        allow read:
          if request.auth != null;

        // Somente o dono do anúncio
        allow create, update:
          if request.auth != null
          && request.auth.uid ==
            get(
              /databases/$(database)/documents/anuncios/$(anuncioId)
            ).data.autorUid;

        allow delete:
          if request.auth != null
          && request.auth.uid ==
            get(
              /databases/$(database)/documents/anuncios/$(anuncioId)
            ).data.autorUid;
      }
    }


    // =====================================================
    // EMPREGOS
    // =====================================================
    match /empregos/{empregoId} {

      allow read: if true;

      allow create:
        if request.auth != null;

      allow update, delete:
        if request.auth != null
        && request.auth.uid == resource.data.autorUid;
    }


    // =====================================================
    // VAGAS TRAMPOLIM
    // =====================================================
    match /vagas/{vagaId} {

      // Vagas públicas
      allow read: if true;

      // Somente Firebase Admin / servidor
      allow write: if false;
    }


    // =====================================================
    // CURRÍCULOS
    // =====================================================
    match /curriculos/{curriculoId} {

      // Currículos públicos
      allow read: if true;

      // Usuário só pode criar o próprio currículo
      allow create:
        if request.auth != null
        && request.auth.uid == curriculoId;

      // Usuário só pode alterar o próprio currículo
      allow update:
        if request.auth != null
        && request.auth.uid == curriculoId;

      // Não permitir exclusão
      allow delete: if false;


      // ===================================================
      // CONTATO PRIVADO DO CURRÍCULO
      // ===================================================
      match /privado/{documento} {

        // Usuário logado pode consultar
        allow read:
          if request.auth != null;

        // Somente o dono
        allow create, update:
          if request.auth != null
          && request.auth.uid == curriculoId;

        allow delete: if false;
      }
    }


    // =====================================================
    // EVENTOS
    // =====================================================
    match /eventos/{eventoId} {

      allow read: if true;

      allow create:
        if request.auth != null;

      allow update, delete:
        if request.auth != null
        && request.auth.uid == resource.data.autorUid;
    }


    // =====================================================
    // NOTÍCIAS
    // =====================================================
    match /noticias/{noticiaId} {

      allow read: if true;

      allow create:
        if request.auth != null;

      allow update, delete:
        if request.auth != null
        && request.auth.uid == resource.data.autorUid;
    }


    // =====================================================
    // TELEFONES
    // =====================================================
    match /telefones/{telefoneId} {

      allow read: if true;

      allow create:
        if request.auth != null;

      allow update, delete:
        if request.auth != null
        && request.auth.uid == resource.data.autorUid;
    }


    // =====================================================
    // LOJAS PARCEIRAS
    // =====================================================
    match /lojas_parceiras/{lojaId} {

      // Somente lojas ativas ficam públicas
      allow read:
        if resource.data.ativo == true;

      // Parceiro pode criar sua própria página
      allow create:
        if request.auth != null
        && request.resource.data.uidDono == request.auth.uid;

      // Somente o dono pode alterar
      // e não pode trocar o proprietário da loja
      allow update:
        if request.auth != null
        && resource.data.uidDono == request.auth.uid
        && request.resource.data.uidDono == resource.data.uidDono;

      // Somente o dono pode excluir
      allow delete:
        if request.auth != null
        && resource.data.uidDono == request.auth.uid;
    }


    // =====================================================
    // ESTATÍSTICAS PÚBLICAS DA COMUNIDADE
    // =====================================================
    match /estatisticas/{documentoId} {

      // Somente leitura pública
      allow read: if true;

      // Ninguém altera pelo navegador
      allow write: if false;
    }
  }
}


