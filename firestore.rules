rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* =====================================================
       FUNÇÃO: ADMIN MASTER
       ===================================================== */

    function isMaster() {
      return request.auth != null
        && exists(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.perfil == "master";
    }

    /* =====================================================
       SOLICITAÇÕES DE DIVULGAÇÃO
       ===================================================== */

    match /solicitacoes_divulgacao/{solicitacaoId} {
      // O formulário público pode criar solicitações.
      allow create: if true;

      // O Master pode consultar todas.
      // O anunciante só pode consultar a própria solicitação aprovada,
      // usando o mesmo e-mail da conta autenticada.
      allow read:
        if isMaster()
        ||
        (
          request.auth != null
          && request.auth.token.email != null
          && request.auth.token.email == resource.data.email
          && resource.data.status == "APROVADO"
        );

      // Somente o Admin Master pode aprovar ou recusar.
      allow update:
        if isMaster();

      // Solicitações não podem ser excluídas pelo navegador.
      allow delete: if false;
    }

    /* =====================================================
       USUÁRIOS / MORADORES
       ===================================================== */

    match /usuarios/{userId} {

      allow read: if true;

      allow create:
        if request.auth != null
        && request.auth.uid == userId;

      allow update:
        if isMaster()
        ||
        (
          request.auth != null
          && request.auth.uid == userId
          && request.resource.data.perfil == resource.data.perfil
          && request.resource.data.status == resource.data.status
        );

      allow delete: if false;
    }

    /* =====================================================
       ANÚNCIOS
       ===================================================== */

    match /anuncios/{anuncioId} {

      allow read: if true;

      allow create:
        if request.auth != null;

      allow update:
        if isMaster()
        ||
        (
          request.auth != null
          && request.auth.uid == resource.data.autorUid
        );

      allow delete:
        if isMaster()
        ||
        (
          request.auth != null
          && request.auth.uid == resource.data.autorUid
        );

      match /privado/{documento} {

        allow read:
          if isMaster()
          ||
          request.auth != null;

        allow create, update:
          if isMaster()
          ||
          (
            request.auth != null
            && request.auth.uid ==
              get(
                /databases/$(database)/documents/anuncios/$(anuncioId)
              ).data.autorUid
          );

        allow delete:
          if isMaster()
          ||
          (
            request.auth != null
            && request.auth.uid ==
              get(
                /databases/$(database)/documents/anuncios/$(anuncioId)
              ).data.autorUid
          );
      }
    }

    /* =====================================================
       EMPREGOS
       ===================================================== */

    match /empregos/{empregoId} {

      allow read: if true;

      allow create:
        if request.auth != null;

      allow update, delete:
        if isMaster()
        ||
        (
          request.auth != null
          && request.auth.uid == resource.data.autorUid
        );
    }

    /* =====================================================
       VAGAS
       ===================================================== */

    match /vagas/{vagaId} {

      allow read: if true;

      allow write:
        if isMaster();
    }

    /* =====================================================
       CURRÍCULOS
       ===================================================== */

    match /curriculos/{curriculoId} {

      allow read: if true;

      allow create:
        if request.auth != null
        && request.auth.uid == curriculoId;

      allow update:
        if isMaster()
        ||
        (
          request.auth != null
          && request.auth.uid == curriculoId
        );

      allow delete:
        if isMaster();

      match /privado/{documento} {

        allow read:
          if isMaster()
          ||
          request.auth != null;

        allow create, update:
          if isMaster()
          ||
          (
            request.auth != null
            && request.auth.uid == curriculoId
          );

        allow delete:
          if isMaster();
      }
    }

    /* =====================================================
       EVENTOS
       ===================================================== */

    match /eventos/{eventoId} {

      allow read: if true;

      allow create:
        if request.auth != null;

      allow update, delete:
        if isMaster()
        ||
        (
          request.auth != null
          && request.auth.uid == resource.data.autorUid
        );
    }

    /* =====================================================
       NOTÍCIAS
       ===================================================== */

    match /noticias/{noticiaId} {

      allow read: if true;

      allow create:
        if request.auth != null;

      allow update, delete:
        if isMaster()
        ||
        (
          request.auth != null
          && request.auth.uid == resource.data.autorUid
        );
    }

    /* =====================================================
       TELEFONES ÚTEIS
       ===================================================== */

    match /telefones/{telefoneId} {

      allow read: if true;

      allow create:
        if isMaster()
        ||
        request.auth != null;

      allow update, delete:
        if isMaster()
        ||
        (
          request.auth != null
          && request.auth.uid == resource.data.autorUid
        );
    }

    /* =====================================================
       LOJAS / ANUNCIANTES
       ===================================================== */

    match /lojas_parceiras/{lojaId} {

      allow read:
        if isMaster()
        ||
        resource.data.ativo == true
        ||
        (
          request.auth != null
          && resource.data.uidDono == request.auth.uid
        );

      allow create:
        if request.auth != null
        && request.resource.data.uidDono == request.auth.uid
        &&
        (
          (
            request.resource.data.status == "PENDENTE"
            && request.resource.data.ativo == false
          )
          ||
          (
            request.resource.data.status == "APROVADO"
            && request.resource.data.ativo == true
            && exists(
              /databases/$(database)/documents/solicitacoes_divulgacao/$(lojaId)
            )
            && get(
              /databases/$(database)/documents/solicitacoes_divulgacao/$(lojaId)
            ).data.status == "APROVADO"
            && get(
              /databases/$(database)/documents/solicitacoes_divulgacao/$(lojaId)
            ).data.email == request.auth.token.email
          )
        );

      allow update:
        if isMaster()
        ||
        (
          request.auth != null
          && resource.data.uidDono == request.auth.uid
          && request.resource.data.uidDono == resource.data.uidDono
          && request.resource.data.status == resource.data.status
          && request.resource.data.ativo == resource.data.ativo
        )
        ||
        (
          request.auth != null
          && request.resource.data.uidDono == request.auth.uid
          && request.resource.data.status == "APROVADO"
          && request.resource.data.ativo == true
          && exists(
            /databases/$(database)/documents/solicitacoes_divulgacao/$(lojaId)
          )
          && get(
            /databases/$(database)/documents/solicitacoes_divulgacao/$(lojaId)
          ).data.status == "APROVADO"
          && get(
            /databases/$(database)/documents/solicitacoes_divulgacao/$(lojaId)
          ).data.email == request.auth.token.email
        );

      allow delete:
        if isMaster()
        ||
        (
          request.auth != null
          && request.auth.uid == resource.data.uidDono
        );
    }

    /* =====================================================
       PRODUTOS / SERVIÇOS DOS ANUNCIANTES
       ===================================================== */

    match /produtos/{produtoId} {

      allow read:
        if isMaster()
        ||
        resource.data.ativo == true
        ||
        (
          request.auth != null
          && resource.data.uidDono == request.auth.uid
        );

      allow create:
        if isMaster()
        ||
        (
          request.auth != null
          && request.resource.data.uidDono == request.auth.uid
          && request.resource.data.lojaId != null
          && get(
            /databases/$(database)/documents/lojas_parceiras/$(request.resource.data.lojaId)
          ).data.uidDono == request.auth.uid
        );

      allow update:
        if isMaster()
        ||
        (
          request.auth != null
          && resource.data.uidDono == request.auth.uid
          && request.resource.data.uidDono == resource.data.uidDono
          && request.resource.data.lojaId == resource.data.lojaId
          && get(
            /databases/$(database)/documents/lojas_parceiras/$(resource.data.lojaId)
          ).data.uidDono == request.auth.uid
        );

      allow delete:
        if isMaster()
        ||
        (
          request.auth != null
          && resource.data.uidDono == request.auth.uid
          && get(
            /databases/$(database)/documents/lojas_parceiras/$(resource.data.lojaId)
          ).data.uidDono == request.auth.uid
        );
    }

    /* =====================================================
       DENÚNCIAS
       ===================================================== */

    match /denuncias/{denunciaId} {

      allow create:
        if request.auth != null
        && request.resource.data.autorUid == request.auth.uid;

      allow read:
        if isMaster()
        ||
        (
          request.auth != null
          && resource.data.autorUid == request.auth.uid
        );

      allow update, delete:
        if isMaster();
    }

    /* =====================================================
       ESTATÍSTICAS
       ===================================================== */

    match /estatisticas/{documentoId} {

      allow read: if true;

      allow write:
        if isMaster();
    }

    /* =====================================================
       CONFIGURAÇÕES DO PORTAL
       ===================================================== */

    match /configuracoes/{documentoId} {

      allow read: if true;

      allow write:
        if isMaster();
    }

    /* =====================================================
       PUBLICIDADES
       ===================================================== */

    match /publicidades/{publicidadeId} {

      allow read:
        if resource.data.ativo == true
        || isMaster();

      allow create, update, delete:
        if isMaster();
    }

    /* =====================================================
       PACOTES DE DIVULGAÇÃO
       ===================================================== */

    match /pacotes_anuncio/{pacoteId} {

      // Os planos são públicos para o anunciante consultar antes de contratar.
      allow read:
        if true;

      allow create, update, delete:
        if isMaster();
    }

    /* =====================================================
       CONTRATOS DE DIVULGAÇÃO
       ===================================================== */

    match /contratos_anuncio/{contratoId} {

      allow read, create, update, delete:
        if isMaster();
    }

    /* =====================================================
       LOGS ADMINISTRATIVOS
       ===================================================== */

    match /logs_admin/{logId} {

      allow read, create:
        if isMaster();

      allow update, delete:
        if false;
    }

  }
}