rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isMaster() {
      return request.auth != null
        && exists(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.perfil == "master";
    }

    match /solicitacoes_divulgacao/{solicitacaoId} {
      allow create: if true;
      allow read:
        if isMaster()
        ||
        (
          request.auth != null
          && request.auth.token.email != null
          && request.auth.token.email == resource.data.email
          && resource.data.status == "APROVADO"
        );
      allow update: if isMaster();
      allow delete: if false;
    }

    match /usuarios/{userId} {
      allow read: if true;
      allow create:
        if request.auth != null
        && request.auth.uid == userId;
      allow update:
        if isMaster()
        ||
        (
          request.auth != null
          && request.auth.uid == userId
          && request.resource.data.perfil == resource.data.perfil
          && request.resource.data.status == resource.data.status
        );
      allow delete: if false;
    }

    match /anuncios/{anuncioId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete:
        if isMaster()
        ||
        (
          request.auth != null
          && request.auth.uid == resource.data.autorUid
        );

      match /privado/{documento} {
        allow read: if isMaster() || request.auth != null;
        allow create, update:
          if isMaster()
          ||
          (
            request.auth != null
            && request.auth.uid ==
              get(
                /databases/$(database)/documents/anuncios/$(anuncioId)
              ).data.autorUid
          );
        allow delete:
          if isMaster()
          ||
          (
            request.auth != null
            && request.auth.uid ==
              get(
                /databases/$(database)/documents/anuncios/$(anuncioId)
              ).data.autorUid
          );
      }
    }

    match /empregos/{empregoId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete:
        if isMaster()
        ||
        (
          request.auth != null
          && request.auth.uid == resource.data.autorUid
        );
    }

    match /vagas/{vagaId} {
      allow read: if true;
      allow write: if isMaster();
    }

    match /curriculos/{curriculoId} {
      allow read: if true;
      allow create:
        if request.auth != null
        && request.auth.uid == curriculoId;
      allow update:
        if isMaster()
        ||
        (
          request.auth != null
          && request.auth.uid == curriculoId
        );
      allow delete: if isMaster();

      match /privado/{documento} {
        allow read: if isMaster() || request.auth != null;
        allow create, update:
          if isMaster()
          ||
          (
            request.auth != null
            && request.auth.uid == curriculoId
          );
        allow delete: if isMaster();
      }
    }

    match /eventos/{eventoId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete:
        if isMaster()
        ||
        (
          request.auth != null
          && request.auth.uid == resource.data.autorUid
        );
    }

    match /noticias/{noticiaId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete:
        if isMaster()
        ||
        (
          request.auth != null
          && request.auth.uid == resource.data.autorUid
        );
    }

    match /telefones/{telefoneId} {
      allow read: if true;
      allow create: if isMaster() || request.auth != null;
      allow update, delete:
        if isMaster()
        ||
        (
          request.auth != null
          && request.auth.uid == resource.data.autorUid
        );
    }

    match /lojas_parceiras/{lojaId} {
      allow read:
        if isMaster()
        || resource.data.ativo == true
        ||
        (
          request.auth != null
          && resource.data.uidDono == request.auth.uid
        );

      allow create:
        if request.auth != null
        && request.resource.data.uidDono == request.auth.uid
        &&
        (
          (
            request.resource.data.status == "PENDENTE"
            && request.resource.data.ativo == false
          )
          ||
          (
            request.resource.data.status == "APROVADO"
            && request.resource.data.ativo == true
            && exists(
              /databases/$(database)/documents/solicitacoes_divulgacao/$(lojaId)
            )
            && get(
              /databases/$(database)/documents/solicitacoes_divulgacao/$(lojaId)
            ).data.status == "APROVADO"
            && get(
              /databases/$(database)/documents/solicitacoes_divulgacao/$(lojaId)
            ).data.email == request.auth.token.email
          )
        );

      allow update:
        if isMaster()
        ||
        (
          request.auth != null
          && resource.data.uidDono == request.auth.uid
          && request.resource.data.uidDono == resource.data.uidDono
          && request.resource.data.status == resource.data.status
          && request.resource.data.ativo == resource.data.ativo
        )
        ||
        (
          request.auth != null
          && request.resource.data.uidDono == request.auth.uid
          && request.resource.data.status == "APROVADO"
          && request.resource.data.ativo == true
          && exists(
            /databases/$(database)/documents/solicitacoes_divulgacao/$(lojaId)
          )
          && get(
            /databases/$(database)/documents/solicitacoes_divulgacao/$(lojaId)
          ).data.status == "APROVADO"
          && get(
            /databases/$(database)/documents/solicitacoes_divulgacao/$(lojaId)
          ).data.email == request.auth.token.email
        );

      allow delete:
        if isMaster()
        ||
        (
          request.auth != null
          && request.auth.uid == resource.data.uidDono
        );
    }

    match /produtos/{produtoId} {
      // Produtos ativos são públicos.
      // O dono da loja pode ler também os produtos ocultos.
      // A propriedade é conferida na loja, e não em uidDono do produto,
      // porque produtos antigos podem não possuir esse campo.
      allow read:
        if isMaster()
        || resource.data.ativo == true
        ||
        (
          request.auth != null
          && resource.data.lojaId != null
          && get(
            /databases/$(database)/documents/lojas_parceiras/$(resource.data.lojaId)
          ).data.uidDono == request.auth.uid
        );

      // O anunciante só pode criar produto dentro da própria loja.
      allow create:
        if isMaster()
        ||
        (
          request.auth != null
          && request.resource.data.lojaId != null
          && get(
            /databases/$(database)/documents/lojas_parceiras/$(request.resource.data.lojaId)
          ).data.uidDono == request.auth.uid
        );

      // O anunciante só pode alterar produto de uma loja que pertence a ele.
      allow update:
        if isMaster()
        ||
        (
          request.auth != null
          && resource.data.lojaId != null
          && request.resource.data.lojaId == resource.data.lojaId
          && get(
            /databases/$(database)/documents/lojas_parceiras/$(resource.data.lojaId)
          ).data.uidDono == request.auth.uid
        );

      // O anunciante só pode excluir produto de uma loja que pertence a ele.
      allow delete:
        if isMaster()
        ||
        (
          request.auth != null
          && resource.data.lojaId != null
          && get(
            /databases/$(database)/documents/lojas_parceiras/$(resource.data.lojaId)
          ).data.uidDono == request.auth.uid
        );
    }

    match /denuncias/{denunciaId} {
      allow create:
        if request.auth != null
        && request.resource.data.autorUid == request.auth.uid;
      allow read:
        if isMaster()
        ||
        (
          request.auth != null
          && request.auth.uid == resource.data.autorUid
        );
      allow update, delete: if isMaster();
    }

    match /estatisticas/{documentoId} {
      allow read: if true;
      allow write: if isMaster();
    }

    match /configuracoes/{documentoId} {
      allow read: if true;
      allow write: if isMaster();
    }

    match /publicidades/{publicidadeId} {
      allow read:
        if resource.data.ativo == true
        || isMaster();
      allow create, update, delete: if isMaster();
    }

    match /pacotes_anuncio/{pacoteId} {
      allow read: if true;
      allow create, update, delete: if isMaster();
    }

    match /contratos_anuncio/{contratoId} {
      allow read:
        if isMaster()
        ||
        (
          request.auth != null
          && resource.data.lojaId != null
          && get(
            /databases/$(database)/documents/lojas_parceiras/$(resource.data.lojaId)
          ).data.uidDono == request.auth.uid
        );
      allow create, update, delete: if isMaster();
    }

    match /logs_admin/{logId} {
      allow read, create: if isMaster();
      allow update, delete: if false;
    }
  }
}